---
import Layout from '../layouts/Layout.astro';
---
<Layout title="CIA - Memory Fragments">
<section id="gallery" class="section-pad">
  <div class="section-header reveal">
    <div class="section-eyebrow">Archives</div>
    <h2 class="section-title">Memory <span>Fragments</span></h2>
    <p class="section-desc">Captured moments from the squad — snapshots from training grounds and battlefields alike.</p>
  </div>
  <div class="gallery-grid">
    <figure class="gallery-card featured reveal">
      <img class="gallery-media" src="/assets/images/gallery/IMG_8149.JPG.webp" alt="Cyber Invasion Army gallery photo IMG 8149" width="1280" height="720" decoding="async"/>
    </figure>
    <figure class="gallery-card reveal reveal-delay-1">
      <img class="gallery-media" src="/assets/images/gallery/IMG_8133.webp" alt="Cyber Invasion Army gallery photo IMG 8133" loading="lazy" width="1440" height="1920" decoding="async"/>
    </figure>
    <figure class="gallery-card reveal reveal-delay-2">
      <img class="gallery-media" src="/assets/images/gallery/IMG_8119.webp" alt="Cyber Invasion Army gallery photo IMG 8119" loading="lazy" width="1440" height="1920" decoding="async"/>
    </figure>
    <figure class="gallery-card reveal">
      <img class="gallery-media" src="/assets/images/gallery/IMG_8046.webp" alt="Cyber Invasion Army gallery photo IMG 8046" loading="lazy" width="1440" height="1920" decoding="async"/>
    </figure>
    <figure class="gallery-card reveal reveal-delay-1">
      <img class="gallery-media" src="/assets/images/gallery/IMG_7303.webp" alt="Cyber Invasion Army gallery photo IMG 7303" loading="lazy" width="1920" height="1440" decoding="async"/>
    </figure>
    <figure class="gallery-card reveal reveal-delay-2">
      <img class="gallery-media" src="/assets/images/gallery/IMG_6809.webp" alt="Cyber Invasion Army gallery photo IMG 6809" loading="lazy" width="1920" height="1440" decoding="async"/>
    </figure>
    <figure class="gallery-card reveal reveal-delay-3">
      <img class="gallery-media" src="/assets/images/gallery/IMG_3614.webp" alt="Cyber Invasion Army gallery photo IMG 3614" loading="lazy" width="1440" height="1920" decoding="async"/>
    </figure>
    <figure class="gallery-card reveal">
      <img class="gallery-media" src="/assets/images/gallery/event1.webp" alt="Cyber Invasion Army gallery photo event 1" loading="lazy" width="1600" height="1200" decoding="async"/>
    </figure>
    <figure class="gallery-card reveal reveal-delay-1">
      <img class="gallery-media" src="/assets/images/gallery/event2.webp" alt="Cyber Invasion Army gallery photo event 2" loading="lazy" width="1600" height="1200" decoding="async"/>
    </figure>
    <figure class="gallery-card reveal reveal-delay-2">
      <img class="gallery-media" src="/assets/images/gallery/event3.webp" alt="Cyber Invasion Army gallery photo event 3" loading="lazy" width="1600" height="1200" decoding="async"/>
    </figure>
    <figure class="gallery-card reveal reveal-delay-3">
      <img class="gallery-media" src="/assets/images/gallery/event4.webp" alt="Cyber Invasion Army gallery photo event 4" loading="lazy" width="1200" height="1600" decoding="async"/>
    </figure>
    <figure class="gallery-card reveal reveal-delay-3">
      <img class="gallery-media" src="/assets/images/gallery/nsu01.jpg" alt="Cyber Invasion Army gallery photo event 4" loading="lazy" width="2048" height="1536" decoding="async"/>
    </figure>
    <figure class="gallery-card reveal">
      <img class="gallery-media" src="/assets/images/gallery/team-at-laptops-01.png" alt="Participants concentrating on their laptops around a shared table at a competition" loading="lazy" width="1439" height="866" decoding="async"/>
    </figure>
    <figure class="gallery-card reveal">
      <img class="gallery-media" src="/assets/images/gallery/team-at-laptops-02.png" alt="Participants working together at a competition table, viewed from the opposite side" loading="lazy" width="1425" height="741" decoding="async"/>
    </figure>
    <figure class="gallery-card reveal">
      <img class="gallery-media" src="/assets/images/gallery/web-exploitation-workshop.webp" alt="Presenter leading a Web Exploitation for Beginners workshop in a computer classroom" loading="lazy" width="1600" height="1200" decoding="async"/>
    </figure>
    <figure class="gallery-card reveal">
      <img class="gallery-media" src="/assets/images/gallery/workshop-presenter-at-lectern.webp" alt="Workshop presenter working at a computer behind a wooden lectern" loading="lazy" width="1086" height="1448" decoding="async"/>
    </figure>
    <figure class="gallery-card reveal">
      <img class="gallery-media" src="/assets/images/gallery/classroom-security-presentation.webp" alt="Presenter explaining security concepts beside projected slides and whiteboard diagrams" loading="lazy" width="1280" height="960" decoding="async"/>
    </figure>
  </div>
</section>
</Layout>
